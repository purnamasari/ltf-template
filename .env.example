# The Letters API the kiosk submits to.
VITE_LETTERS_API_BASE=https://letters.dev.heydewi.com

# Shown in the dashboard device list so staff can tell tablets apart.
VITE_KIOSK_LABEL=Raffles kiosk

# Four digits, entered after the logo gesture to reach the pairing screen.
VITE_STAFF_PASSCODE=1887

# true (the default) simulates pairing and delivery with no backend.
VITE_DEMO_MODE=true
